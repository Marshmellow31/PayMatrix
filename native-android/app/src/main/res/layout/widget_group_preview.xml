<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background_light">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/logo" android:contentDescription="paymatrix"/>
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Weekend trip" android:textColor="#191A18" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_configure" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="Edit" android:textColor="#315B43" android:textSize="12sp" android:contentDescription="Choose widget group"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/widget_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="You owe" android:textSize="12sp" android:textColor="#62635D"/>
            <TextView android:id="@+id/widget_balance" android:layout_width="match_parent" android:layout_height="36dp" android:text="₹1,250" android:textColor="#191A18" android:textStyle="bold" android:textSize="26sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="26sp" android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout android:visibility="gone" android:id="@+id/widget_second_column" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:id="@+id/widget_second_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="You are owed" android:textSize="12sp" android:textColor="#62635D"/>
            <TextView android:id="@+id/widget_secondary" android:layout_width="match_parent" android:layout_height="36dp" android:text="₹0" android:textColor="#315B43" android:textStyle="bold" android:textSize="26sp" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="16sp" android:autoSizeMaxTextSize="26sp" android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Saved balances · tap to refresh" android:textSize="12sp" android:textColor="#62635D" android:maxLines="2" android:layout_marginTop="4dp"/>
    <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:layout_marginTop="8dp">
        <TextView android:id="@+id/widget_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:text="Add expense" android:textColor="#244C35" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/widget_button_light"/>
        <TextView android:id="@+id/widget_add" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="8dp" android:gravity="center" android:text="Scan bill" android:textColor="#244C35" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/widget_button_light"/>
    </LinearLayout>
</LinearLayout>