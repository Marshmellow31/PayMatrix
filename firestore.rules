rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ─────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Platform-level admin via Firebase Custom Claims only.
    // UID fallback removed — grant admin via Admin Panel > Users > Grant Admin Claims.
    function isGlobalAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isMember(groupId) {
      let groupPath = /databases/$(database)/documents/groups/$(groupId);
      return isSignedIn() && exists(groupPath) && request.auth.uid in get(groupPath).data.get('members', []);
    }

    function isAdmin(groupId) {
      let groupPath = /databases/$(database)/documents/groups/$(groupId);
      let groupData = get(groupPath).data;
      return isSignedIn() && exists(groupPath) &&
             (request.auth.uid == groupData.get('admin', '') || request.auth.uid == groupData.get('createdBy', ''));
    }

    // ─── Validation Helpers ───────────────────────────────────────────────────

    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isValidAmount(val) {
      return val is number && val > 0 && val <= 1000000;
    }

    // ─── Users ────────────────────────────────────────────────────────────────

    match /users/{userId} {
      // FIX SEC-04: removed dangling '|| isSignedIn()' that granted every authenticated
      // user read access to every other user's full profile document.
      allow read: if isGlobalAdmin() || (isSignedIn() && (
        request.auth.uid == userId ||
        request.auth.uid in resource.data.get('friends', [])
      ));
      allow create: if isSignedIn() && request.auth.uid == userId &&
                    isValidString(request.resource.data.get('displayName', ''), 50);
      allow update: if isGlobalAdmin() || (isSignedIn() && (
        (request.auth.uid == userId &&
         isValidString(request.resource.data.get('displayName', ''), 50) &&
         isValidString(request.resource.data.get('upiId', ''), 100) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email', 'createdAt'])
        ) ||
        (
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']) &&
         (
           request.resource.data.get('friends', []).removeAll(resource.data.get('friends', [])) == [request.auth.uid] ||
           resource.data.get('friends', []).removeAll(request.resource.data.get('friends', [])) == [request.auth.uid]
         )
        ) ||
        (
         request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken'])
        )
      ));
      allow delete: if false;
    }

    // ─── Groups ───────────────────────────────────────────────────────────────

    match /groups/{groupId} {
      allow read: if isGlobalAdmin() || (isSignedIn() && (
        request.auth.uid in resource.data.members ||
        request.auth.uid in resource.data.get('historicalMembers', [])
      ));
      allow create: if isSignedIn() &&
                    isValidString(request.resource.data.name, 100) &&
                    request.resource.data.members is list;
      allow update: if isGlobalAdmin() || (isSignedIn() && (
        isAdmin(groupId) ||
        (request.resource.data.get('members', []).hasAll(resource.data.get('members', [])) &&
         request.resource.data.get('inviteCode', '') == resource.data.get('inviteCode', '')) ||
        (resource.data.get('members', []).removeAll(request.resource.data.get('members', [])) == [request.auth.uid] &&
         request.resource.data.get('inviteCode', '') == resource.data.get('inviteCode', ''))
      ) && isValidString(request.resource.data.get('name', request.resource.data.get('title', '')), 100));
      allow delete: if isGlobalAdmin() || isAdmin(groupId);

      match /expenses/{expenseId} {
        allow read: if isGlobalAdmin() || isMember(groupId);
        allow create: if isMember(groupId) &&
                      isValidString(request.resource.data.title, 100) &&
                      isValidAmount(request.resource.data.amount) &&
                      request.resource.data.participants is list;
        allow update: if isMember(groupId) &&
                      isValidString(request.resource.data.get('title', ''), 100) &&
                      (request.resource.data.get('amount', 0) == 0 || isValidAmount(request.resource.data.amount));
        allow delete: if isGlobalAdmin() || isMember(groupId);
      }

      match /settlements/{settlementId} {
        allow read:   if isGlobalAdmin() || isMember(groupId);
        allow create: if isMember(groupId) && isValidAmount(request.resource.data.amount);
        // FIX: payer can no longer unilaterally delete a settlement (fraud vector).
        // Any member can soft-delete (status:'deleted') via update.
        // Hard deletes require group admin or global admin.
        allow update: if isMember(groupId);
        allow delete: if isGlobalAdmin() || isAdmin(groupId);
      }

      match /logs/{logId} {
        allow read: if isGlobalAdmin() || isMember(groupId);
        allow create: if isMember(groupId);
        allow update, delete: if false;
      }
    }

    // ─── Friend Requests ──────────────────────────────────────────────────────

    match /friendRequests/{requestId} {
      allow read: if isGlobalAdmin() || (isSignedIn() && (
        request.auth.uid == resource.data.from || request.auth.uid == resource.data.to
      ));
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if isSignedIn() &&
                    request.auth.uid == request.resource.data.from &&
                    request.resource.data.to is string;
      allow update: if isSignedIn() && request.auth.uid == resource.data.to;
    }

    // ─── Notifications ────────────────────────────────────────────────────────

    match /notifications/{notificationId} {
      allow read, update, delete: if isGlobalAdmin() || (isSignedIn() && request.auth.uid == resource.data.to);
      // FIX SEC-08: any signed-in user could previously create notifications targeting any other user.
      // Now clients may only create notifications targeting themselves (system alerts).
      // Cross-user notifications are created by trusted Cloud Functions.
      allow create: if isSignedIn() && request.resource.data.to == request.auth.uid;
    }

    // ─── Security Logs ────────────────────────────────────────────────────────

    match /security_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isGlobalAdmin();
      allow update, delete: if false;
    }

    // ─── Rate Limits ──────────────────────────────────────────────────────────

    match /rate_limits/{userId} {
      // FIX: users can read their own limit doc but cannot write it directly —
      // users could previously reset their own rate-limit counters.
      allow read:  if isGlobalAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isGlobalAdmin();
    }

    // ─── AI Requests ──────────────────────────────────────────────────────────

    match /ai_requests/{requestId} {
      allow read: if isGlobalAdmin() || (isSignedIn() && request.auth.uid == resource.data.uid);
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    // ─── Feature Flags (admin write, all signed-in users read) ───────────────

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isGlobalAdmin();
    }

    // ─── Admin Notification History ───────────────────────────────────────────

    match /admin_notifications/{docId} {
      allow read, write: if isGlobalAdmin();
    }
  }
}
