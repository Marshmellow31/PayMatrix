# Firebase Configuration
# Copy these values from your Firebase Project Settings
VITE_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-app-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:xxxxxxxxxxxxxxxxxxxxxx"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Optional: route callable Functions to the local emulator on port 5001.
# Leave false for normal localhost use against the configured Firebase project.
VITE_USE_FIREBASE_EMULATORS="false"

# FCM Web Push VAPID Key — required for push notifications
# How to get it:
#   Firebase Console → Project Settings → Cloud Messaging
#   → Web Push certificates → Generate key pair → copy the "Key pair" value
VITE_FIREBASE_VAPID_KEY="BXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Optional for packaged clients. The browser defaults to same-origin /api/scan-bill.
VITE_SCAN_API_URL="https://pay-matrix.vercel.app/api/scan-bill"

# Receipt scanning: server-only. Never use VITE_GEMINI_API_KEY.
GEMINI_API_KEY="replace_with_rotated_server_only_key"

# Razorpay Standard Checkout proof. The VITE_ values are public browser configuration.
VITE_RAZORPAY_KEY_ID="rzp_test_replace_me"
VITE_RAZORPAY_TEST_CHECKOUT_ENABLED="false"
VITE_RAZORPAY_SUBSCRIPTIONS_ENABLED="false"

# Server-side kill switches. Browser flags never enable a payment endpoint by themselves.
RAZORPAY_TEST_CHECKOUT_ENABLED="false"
RAZORPAY_SUBSCRIPTIONS_ENABLED="false"
# Pause new purchases without stopping verification, cancellation or webhook delivery.
RAZORPAY_CHECKOUT_PAUSED="false"

# These are server-only Vercel Function variables. Never prefix the secret with VITE_.
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace_after_rotating_the_exposed_test_secret"
RAZORPAY_PLAN_MONTHLY_INR="plan_replace_me"
RAZORPAY_PLAN_YEARLY_INR="plan_replace_me"
RAZORPAY_WEBHOOK_SECRET="replace_with_server_only_webhook_secret"

# Firebase Admin Service Account (Vercel serverless / webhook functions only)
FIREBASE_ADMIN_PROJECT_ID="your-app-id"
FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-app-id.iam.gserviceaccount.com"
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Note: For production deployment (Vercel/Firebase Hosting),
# move these keys to your hosting platform's Environment Variables dashboard.
#
# The Gemini and Razorpay secrets are intentionally NOT VITE_ variables — VITE_ vars
# are inlined into the public browser bundle. Set GEMINI_API_KEY and
# RAZORPAY_KEY_SECRET ONLY in the server environment.
#
# Admin access is granted exclusively via Firebase custom claims
# (see scripts/set-admin.js). There is no admin password.
